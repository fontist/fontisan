---
import Site from "../layouts/Site.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const features = [
  { title: "🔄 Font Conversion", details: "Convert between TTF, OTF, WOFF, WOFF2, Type 1 (PFB/PFA), and SVG formats with curve conversion and optimization." },
  { title: "✅ Font Validation", details: "Comprehensive validation with 5 profiles (OpenType, Google Fonts, Microsoft, Adobe, Production), 56 helpers, and custom DSL." },
  { title: "🎨 Color Fonts", details: "Full support for COLR/CPAL layered color fonts, sbix bitmap fonts, and SVG-based color fonts." },
  { title: "⚡ Variable Fonts", details: "Process OpenType variable fonts with instance generation, format conversion, and named instance support." },
  { title: "🔧 Font Hinting", details: "Bidirectional hint conversion between TrueType and PostScript formats — a unique Fontisan capability." },
  { title: "📦 Type 1 Support", details: "Adobe Type 1 fonts (PFB/PFA) with eexec decryption, CharString parsing, and conversion to modern formats." },
  { title: "📚 Collections", details: "TTC/OTC/dfont collection support with pack, unpack, table deduplication, and format conversion." },
  { title: "💎 Pure Ruby", details: "Zero external dependencies. No Python, no C++, no C# required. Works anywhere Ruby runs." },
];
---
<Site title="Fontisan — Universal font processing library for Ruby" description="The most comprehensive font processing library for Ruby — 100% Pure Ruby, no Python, no C++, no C# dependencies.">
  <section class="fontisan-hero">
    <div class="pure-ruby-hero">💎 100% Pure Ruby</div>
    <h1 class="hero-name">Fontisan</h1>
    <p class="hero-text">Universal font processing library for Ruby</p>
    <p class="hero-tagline">The most comprehensive font library — 100% Pure Ruby, no Python, no C++, no C# dependencies.</p>
    <div class="hero-actions">
      <a class="action brand" href={`${base}/guide/`}>Get Started</a>
      <a class="action alt" href="https://github.com/fontist/fontisan">View on GitHub</a>
      <a class="action alt" href={`${base}/guide/migrations/fonttools`}>Migrate from fonttools</a>
    </div>
    <div class="hero-terminal">
      <div class="term-title">fontisan</div>
      <div class="term-body">
        <div class="line"><span class="comment"># Get detailed font information</span></div>
        <div class="line"><span class="prompt">$</span> <span class="cmd">fontisan</span> info OpenSans-Regular.ttf</div>
        <div class="line">Family: Open Sans    Style: Regular    Format: TTF</div>
        <div class="line"><span class="comment"># Convert between formats</span></div>
        <div class="line"><span class="prompt">$</span> <span class="cmd">fontisan</span> convert font.ttf --to woff2</div>
        <div class="line"><span class="success">✓</span> font.woff2 created (45% smaller)</div>
        <div class="line"><span class="comment"># Validate with Google Fonts profile</span></div>
        <div class="line"><span class="prompt">$</span> <span class="cmd">fontisan</span> validate font.ttf -p google_fonts</div>
        <div class="line"><span class="success">✓</span> All 56 checks passed</div>
      </div>
    </div>
  </section>

  <section class="features-grid">
    {features.map((f) => (
      <div class="feature-card">
        <div class="feature-title">{f.title}</div>
        <div class="feature-details">{f.details}</div>
      </div>
    ))}
  </section>

  <article class="prose home-prose">
    <h2>Why Fontisan?</h2>
    <p>
      Fontisan is the <strong>most comprehensive font processing library in pure Ruby</strong>, combining the
      capabilities of:
    </p>
    <ul>
      <li><strong>fonttools</strong> (Python) — 100+ OpenType tables, variable fonts, subsetting</li>
      <li><strong>lcdf-typetools</strong> (C++) — otfinfo, cfftot1, Type 1 validation</li>
      <li><strong>Font-Validator</strong> (C#) — Comprehensive validation with coverage reports</li>
    </ul>
    <p>
      <strong>The key differentiator</strong>: Fontisan is 100% pure Ruby. No Python, no C++, no C# dependencies.
      Install and run anywhere Ruby runs.
    </p>

    <h2>Feature Comparison</h2>
    <table>
      <thead>
        <tr><th>Feature</th><th>fonttools</th><th>lcdf-typetools</th><th>Font-Validator</th><th><strong>Fontisan</strong></th></tr>
      </thead>
      <tbody>
        <tr><td>Pure Ruby</td><td>❌</td><td>❌</td><td>❌</td><td>✅</td></tr>
        <tr><td>Python-free</td><td>❌</td><td>✅</td><td>✅</td><td>✅</td></tr>
        <tr><td>Font conversion</td><td>✅</td><td>✅</td><td>❌</td><td>✅</td></tr>
        <tr><td>Validation</td><td>❌</td><td>❌</td><td>✅</td><td>✅</td></tr>
        <tr><td>Bidirectional hints</td><td>❌</td><td>Partial</td><td>❌</td><td>✅</td></tr>
        <tr><td>Variable fonts</td><td>✅</td><td>❌</td><td>❌</td><td>✅</td></tr>
        <tr><td>Type 1 support</td><td>Partial</td><td>✅</td><td>❌</td><td>✅</td></tr>
      </tbody>
    </table>
    <p><a href={`${base}/guide/comparisons/`}>See full comparison →</a></p>

    <h2>CLI Usage</h2>
    <pre><code>{`# Get font information
fontisan info font.ttf

# Convert fonts
fontisan convert input.ttf --to otf --output output.otf

# Validate fonts
fontisan validate font.ttf --profile google_fonts

# Work with collections
fontisan unpack fonts.ttc --output-dir ./extracted`}</code></pre>
  </article>
</Site>

<style>
  .fontisan-hero {
    text-align: center;
    padding: 3.5rem 1.5rem 2rem;
  }
  .hero-name {
    font-family: var(--spec-font-display);
    font-size: 3.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 1rem 0 0.25rem;
    background: linear-gradient(120deg, var(--fontist-rose) 30%, var(--fontist-rose-light));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-text {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--vp-c-text-1);
    margin: 0;
  }
  .hero-tagline {
    color: var(--vp-c-text-2);
    margin: 0.5rem auto 1.25rem;
    max-width: 620px;
  }
  .pure-ruby-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    background: linear-gradient(135deg, #bf4e6a, #d4718a);
    color: white;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.5rem;
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .action {
    padding: 0.6rem 1.4rem;
    border-radius: 10px;
    font-weight: 500;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .action.brand {
    background: var(--spec-rose);
    color: #fff;
  }
  .action.brand:hover {
    background: #a3435a;
    color: #fff;
  }
  .action.alt {
    border: 1px solid var(--spec-rule-strong);
    color: var(--vp-c-text-1);
  }
  .action.alt:hover {
    border-color: var(--spec-rose);
    color: var(--spec-rose);
  }
  .hero-terminal {
    max-width: 640px;
    margin: 0 auto;
    text-align: left;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--spec-rule);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
  }
  .term-title {
    background: var(--spec-term-bg);
    color: var(--spec-term-ink);
    font-family: var(--vp-font-family-mono);
    font-size: 0.8rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .term-body {
    background: var(--spec-term-bg);
    color: var(--spec-term-ink);
    font-family: var(--vp-font-family-mono);
    font-size: 0.85rem;
    line-height: 1.7;
    padding: 1rem 1.25rem;
  }
  .term-body .comment { color: #8f887e; }
  .term-body .prompt { color: var(--spec-rose-soft); }
  .term-body .cmd { color: #ecdfd0; font-weight: 500; }
  .term-body .success { color: #7fbf7f; }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    max-width: 1080px;
    margin: 1rem auto 2rem;
    padding: 0 1.5rem;
  }
  .feature-card {
    border: 1px solid var(--spec-rule);
    border-radius: 12px;
    padding: 1.25rem;
    background: var(--vp-c-bg-soft);
    transition: border-color 0.2s;
  }
  .feature-card:hover {
    border-color: var(--spec-rose);
  }
  .feature-title {
    font-weight: 600;
    color: var(--vp-c-text-1);
    margin-bottom: 0.4rem;
  }
  .feature-details {
    font-size: 0.875rem;
    color: var(--vp-c-text-2);
    line-height: 1.6;
  }
  .home-prose {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 1.5rem 2rem;
  }
</style>
