---
import Site from "../../layouts/Site.astro";
import { getCollection, render } from "astro:content";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const entries = await getCollection("history");
const indexEntry = entries.find((e) => e.id === "index");
const renderEntry = indexEntry
  ? (await render(indexEntry)).Content
  : null;
const others = entries.filter((e) => e.id !== "index");
---
<Site title="History — Fontisan" description="Fontisan release history">
  {renderEntry ? <article class="prose doc-page"><renderEntry /></article> : (
    <article class="prose doc-page">
      <h1>History</h1>
      <ul>
        {others.map((e) => (
          <li><a href={`${base}/history/${e.id}`}>{e.data?.title ?? e.body?.match(/^# (.+)$/m)?.[1] ?? e.id}</a></li>
        ))}
      </ul>
    </article>
  )}
</Site>
